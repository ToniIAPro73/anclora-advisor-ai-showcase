{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "anclora-advisor-ai-showcase",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "advisor-showcase.anclora.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "development": {
      "name": "anclora-advisor-ai-showcase-development",
      "workers_dev": true,
      "routes": []
    }
  }
}
